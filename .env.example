# ============================================
# BizPlan AI - 환경변수 템플릿
# .env.local 에 복사하여 실제 값을 입력하세요
# ============================================

# ===== 필수 (CRITICAL) =====

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (관리자 비밀번호 — 반드시 강력한 비밀번호 사용)
ADMIN_PASSWORD=

# ===== 권장 (IMPORTANT) =====

# Cron 보안 (Vercel Cron 인증용, openssl rand -hex 32 로 생성)
CRON_SECRET=

# ===== AI =====

# AI 모드 (local=Claude Max 무료 프록시, api=Anthropic API 유료)
AI_MODE=local
CLAUDE_PROXY_URL=http://localhost:3457
LOG_AI_CALLS=true
ANTHROPIC_API_KEY=

# OpenAI (임베딩용)
OPENAI_API_KEY=

# Perplexity (사업계획서 리서치 품질 향상, 선택)
PERPLEXITY_API_KEY=

# ===== 결제 (PortOne V2) =====
# https://admin.portone.io

PORTONE_API_SECRET=
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=

# ===== 정부지원사업 API =====

# 공공데이터포털
DATA_GO_KR_SERVICE_KEY=

# 기업마당
BIZINFO_CRTFC_KEY=
BIZINFO_API_URL=https://www.bizinfo.go.kr/uss/rss/bizinfoApi.do
MSS_BIZ_API_URL=https://apis.data.go.kr/1421000/mssBizService_v2/getbizList_v2
KSTARTUP_API_URL=https://apis.data.go.kr/B552735/kisedKstartupService01/getAnnouncementInformation01

# ===== 알림 =====

# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_GOV=

# Solapi (카카오 알림톡)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_KAKAO_PF_ID=
SOLAPI_SENDER_PHONE=
SOLAPI_TPL_MATCHING=
SOLAPI_TPL_DEADLINE=
SOLAPI_TPL_PLAN_COMPLETE=

# ===== 모니터링 =====

# Sentry (https://sentry.io)
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=

# ===== 기타 =====

# Notion (Agent Meeting 자동 업로드)
NOTION_API_KEY=

# Redis (선택 — 없으면 인메모리 캐시 자동 사용)
# REDIS_URL=redis://localhost:6379

# Google Analytics
NEXT_PUBLIC_GA_ID=

# App URL
NEXT_PUBLIC_APP_URL=https://bizplanai.co.kr

# Node.js TLS (개발 환경 전용, 프로덕션에서는 제거)
# NODE_TLS_REJECT_UNAUTHORIZED=0
